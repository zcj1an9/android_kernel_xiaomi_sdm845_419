# Platform
CONFIG_MACH_XIAOMI_E1N=y

# Audio
CONFIG_SND_SOC_TAS2557=y
CONFIG_SND_ELLIPTIC=y
CONFIG_MFD_SPK_ID=y

# Camera
CONFIG_USE_ROHM_BU64753=y

# LEDS
CONFIG_LEDS_LM3644=y

# GPS
CONFIG_BCM_GPS_SPI_DRIVER=y

# Fingerprint
CONFIG_INPUT_FINGERPRINT=y
CONFIG_FINGERPRINT_FP_VREG_CONTROL=y
CONFIG_FINGERPRINT_FPC_TEE=y
CONFIG_FINGERPRINT_FPC_SCREEN_NOTIFY=y
CONFIG_FINGERPRINT_GOODIX_TA=y

# Touchscreen
CONFIG_TOUCHSCREEN_ST_FTS_V521=y
CONFIG_I2C_BY_DMA=y
CONFIG_SECURE_TOUCH=y
CONFIG_TOUCHSCREEN_ATMEL_MXT_MI=y
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE_GAMEMODE=y
# CONFIG_LPM_DISABLE is not set

# Android boot compatibility (also used by dipper-a17-boot.config).
CONFIG_INITRAMFS_IGNORE_SKIP_FLAG=y
CONFIG_DEVTMPFS=y
# CONFIG_DEVTMPFS_MOUNT is not set
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_PCPU_KTHREAD=y
CONFIG_EROFS_FS_PCPU_KTHREAD_HIPRI=y
# CONFIG_ARM_ARCH_TIMER_VCT_ACCESS is not set
CONFIG_KRYO_PMU_WORKAROUND=y
CONFIG_PCI_MSM_MSI=y
# CONFIG_RELR is not set
# CONFIG_MODULE_SIG is not set
# CONFIG_CMDLINE_FROM_BOOTLOADER is not set
CONFIG_CMDLINE_EXTEND=y
CONFIG_CMDLINE="cgroup_disable=pressure"
