# Dipper Android boot compatibility configuration.
CONFIG_INITRAMFS_IGNORE_SKIP_FLAG=y
CONFIG_DEVTMPFS=y
# CONFIG_DEVTMPFS_MOUNT is not set
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_PCPU_KTHREAD=y
CONFIG_EROFS_FS_PCPU_KTHREAD_HIPRI=y
# CONFIG_ARM_ARCH_TIMER_VCT_ACCESS is not set
CONFIG_KRYO_PMU_WORKAROUND=y
CONFIG_PCI_MSM_MSI=y
# CONFIG_RELR is not set
# CONFIG_MODULE_SIG is not set
# CONFIG_CMDLINE_FROM_BOOTLOADER is not set
CONFIG_CMDLINE_EXTEND=y
CONFIG_CMDLINE="cgroup_disable=pressure"
CONFIG_LOCALVERSION="-perf-a17-v3"
# CONFIG_LOCALVERSION_AUTO is not set
